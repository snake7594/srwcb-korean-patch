 },
 {
  "off": 24174,
  "end": 24271,
  "jp": "予告編<f6>DrJ「コロニ-に核攻撃を仕掛けるなどと人道に<f6>外れた戦術も,なりふりかまわぬ勝利のためなら<f6>いたしかたないのだろう。よってここに降伏を宣言する」"
 },
 {
  "off": 24271,
  "end": 24309,
  "jp": "レディ「よし,降伏を認める。ただちにガンダムモドキは<f6>投降せよ」"
 },
 {
  "off": 24412,
  "end": 24431,
  "jp": "ヒイロ「任務‥‥了解!」"
 },
 {
  "off": 24455,
  "end": 24502,
  "jp": "ギレン「ハマ-ンよ,よくぞ我々のおらぬ間,DCを<f6>維持してきてくれた。礼をいうぞ」"
 },
 {
  "off": 24502,
  "end": 24524,
  "jp": "ハマ-ン「‥‥もったいないお言葉」"
 },
 {
  "off": 24524,
  "end": 24594,
  "jp": "キシリア「しかし総帥,現在の情況は,決して順調とは<f6>いえません。早急に組織の再編を行う必要があります」"
 },
 {
  "off": 24594,
  "end": 24608,
  "jp": "ギレン「そうだな‥‥」"
 },
 {
  "off": 24608,
  "end": 24641,
  "jp": "レディ「閣下‥‥これからいかがなさるおつもりなのです?」"
 },
 {
  "off": 24641,
  "end": 24694,
  "jp": "トレ-ズ「時代は私を排除しようとしている。<f6>ならば,私はその流れに逆らう事はできない」"
 },
 {
  "off": 24694,
  "end": 24708,
  "jp": "レディ「閣下‥‥」"
 },
 {
  "off": 24708,
  "end": 24739,
  "jp": "トレ-ズ「わかってくれ,レディ。今はその時ではないのだ」"
 },
 {
  "off": 24881,
  "end": 24934,
  "jp": "ハタリ「ああ,モニタ-に映っているのは,どう見ても<f6>土星だ。全天座標がずれているらしい」"
 },
 {
  "off": 24934,
  "end": 24945,
  "jp": "ベス「故障か?」"
 },
 {
  "off": 24945,
  "end": 24965,
  "jp": "ハタリ「わからん‥‥調べてみる」"
 },
 {
  "off": 25048,
  "end": 25073,
  "jp": "ダラム「僥倖というべきなのだろうな‥‥」"
 },
 {
  "off": 25073,
  "end": 25081,
  "jp": "ギジェ「は?」"
 },
 {
  "off": 25178,
  "end": 25186,
  "jp": "ギジェ「はっ」"
 },
 {
  "off": 25186,
  "end": 25244,
  "jp": "ダラム「忘れるな,我々は正規軍ではないのだ。<f6>巨神をとらえるために給料をもらっているのだからな」"
 },
 {
  "off": 25256,
  "end": 25395,
  "jp": "[F9]「‥‥‥?」[F9]「‥‥‥?」[F9]「‥‥‥?」[F9]「‥‥‥?」[F9]「‥‥‥?」[F9]「‥‥‥?」[F9]「‥‥‥?」シンジ「‥‥今日は,[F9]さんの誕生日ですよね。<f6>お祝いに,みんなでケ-キを作ってみたんですけど‥‥」"
 },
 {
  "off": 25395,
  "end": 25460,
  "jp": "アスカ「そうよ,あなたのために私達が精根込めて<f6>作ったんだから。願い事でもしてさっさと火<f6>消しなさいよっ!」"
 },
 {
  "off": 25460,
  "end": 25505,
  "jp": "シンジ「‥‥よく言うよ‥‥アスカはロウソクを<f6>立てただけじゃないか‥‥」"
 },
 {
  "off": 25505,
  "end": 25543,
  "jp": "アスカ「な,何よあんた,文句があるのなら<f6>はっきりいいなさいよ!!」"
 },
 {
  "off": 25598,
  "end": 25615,
  "jp": "アスカ「な,何よ何なのよ!」"
 },
 {
  "off": 25715,
  "end": 25773,
  "jp": "トウジ「さて,ケンカもおさまったことやし<f6>[F9]さん火ぃ消して下さい。<f6>今,電気消しますんで‥‥」"
 },
 {
  "off": 25773,
  "end": 25840,
  "jp": "トウジ「どないしたんです,何で消さんのですか?<f6>自分ら[F9]さんのために用意したんです。<f6>遠慮せずに,どうぞ,どうぞ」"
 },
 {
  "off": 25840,
  "end": 25876,
  "jp": "アスカ「そうよ,このバカの言うとおりだわ<f6>さっさと消しなさいよ!」"
 },
 {
  "off": 25967,
  "end": 25991,
  "jp": "トウジ「惣流,お前が火ぃ消したやろ」"
 },
 {
  "off": 26026,
  "end": 26073,
  "jp": "シンジ「そうだよトウジ。いくらアスカでも<f6>そんな事するはずないよ。そう思うよね綾波」"
 },
 {
  "off": 26073,
  "end": 26091,
  "jp": "レイ「‥‥消したわ‥‥」"
 },
 {
  "off": 26091,
  "end": 26121,
  "jp": "シンジ「ああ,はっきり言うけどアスカはいつでも‥‥」"
 },
 {
  "off": 26121,
  "end": 26161,
  "jp": "トウジ「お前ら夫婦ゲンカするんやったら<f6>この部屋から出ていけや!」"
 },
 {
  "off": 26161,
  "end": 26181,
  "jp": "アスカ「な,何よ,うるさいわね!!」"
 },
 {
  "off": 26190,
  "end": 26229,
  "jp": "アスカ「で,出ていけばいいんでしょ,出ていけば!<f6>いくわよバカシンジ!」"
 },
 {
  "off": 26229,
  "end": 26248,
  "jp": "シンジ「ま,待てよアスカ‥‥」"
 },
 {
  "off": 26248,
  "end": 26303,
  "jp": "トウジ「[F9]さん,あいつらのことはほっといて<f6>火ぃ消して下さい。今,電気消しますんで‥‥」"
 },
 {
