# Executables, emulator modules, saves, and states
*.exe
*.dll
*.so
*.dylib
*.mcr
*.srm
*.state*
scph*.bin

# Archives can accidentally carry ignored game data
*.zip
*.7z
*.rar
*.tar
*.gz

# Common extracted PS1 game assets
SLPS_*
*.WAR
*.XA
*.STR
*.VAB

# Extracted or local test material
extracted/
local_inputs/
test_build/
font_candidates/
screenshots/
saves/
states/
bios/
system/
logs/
RetroArch*/
release/GITHUB_RELEASE_SHA256SUMS.txt

# Tool caches and platform files
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# 빌드 작업 폴더 (게임에서 나온 것·중간 산출물 — 절대 커밋 금지)
work/

# 릴리스 산출물은 GitHub Releases 로만 배포한다 (저장소에 담지 않음)
release/*.xdelta
release/*.zip
!release/SHA256SUMS*.txt

# 프로젝트 자산(생성물이 아니라 소스)
!third-ui/third_quit_pool.bin
